@startuml ClassroomReservationSystem

skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction

package "Client Side (View & Controller)" {

    component "View" {
        [LoginGUI]
        [AdminGUI]
        [AssistantGUI]
        [UserGUI]
    }

    component "Controller" {
        [UserController]
        [ReservationController]
        [TimetableController]
        [NotificationController]
        [SessionManager]
    }

    [LoginGUI] --> [UserController] : login
    [AdminGUI] --> [UserController] : user CRUD
    [AssistantGUI] --> [ReservationController] : approve/reject
    [AssistantGUI] --> [TimetableController] : room info
    [UserGUI] --> [ReservationController] : reserve/cancel
    [UserGUI] --> [TimetableController] : timetable
    [UserController] --> [SessionManager] : login/logout

    [CRSystemClient] <<Socket Controller>>
    [Controller] --> [CRSystemClient] : Request Object
}

cloud "TCP/IP Network" {
    [CRSystemClient] <--> [ClientHandler] : ObjectInputStream/OutputStream\n(Serialized Java Objects)
}

package "Server Side (Model & Logic)" {

    [CRSystemServer] --> [ClientHandler] : Accept Connection

    [ClientHandler] --> [MainController] : RequestDTO

    node "Request Handlers" {
        [MainController] --> [LoginHandler] : Route (UserDTO)
        [MainController] --> [UserHandler] : Route (UserDTO)
        [MainController] --> [ReservationHandler] : Route (ReservationDTO)
        [MainController] --> [TimetableHandler] : Route (ScheduleData)
        [MainController] --> [NotificationHandler] : Route (NotificationDTO)
    }

    database "File Storage (.json)" {
        [UserFileManager]
        [ReservationFileManager]
    }

    node "In-Memory Catalog" {
        [UserCatalog]
        [ReservationCatalog]
        [NotificationCatalog]
    }

    [LoginHandler] ..> [UserHandler] : delegates
    [UserHandler] ..> [UserFileManager]
    [UserHandler] ..> [UserCatalog]
    [ReservationHandler] ..> [ReservationFileManager]
    [ReservationHandler] ..> [ReservationCatalog]
    [NotificationHandler] ..> [NotificationCatalog]
}

package "Common Module" {

    package "common.dto" {
        [RequestDTO]
        [ResponseDTO]
        [UserDTO]
        [ReservationDTO]
        [NotificationDTO]
        [ScheduleData]
        [DayReservation]
        [Classroom]
        [ClassroomInfo]
        [Reservation]
    }

    package "common.enums" {
        [Role]
    }
}

@enduml
